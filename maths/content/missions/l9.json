    {
     "say": [
      "Make another quarter turn."
     ],
     "goal": {
      "turns": 2
     },
     "then": [
      "2 quarter turns make a half turn.",
      "Now it faces down."
     ]
    },
    {
     "say": [
      "Keep turning until it faces up again."
     ],
     "goal": {
      "dir": "N",
      "turns": {
       "gte": 4
      }
     },
     "then": [
      "4 quarter turns make a whole turn!",
      "It is back where it started."
