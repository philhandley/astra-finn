   "widget": "shapes2d",
   "props": {
    "shape": "triangle",
    "tap": "sides"
   },
   "script": [
    {
     "say": [
      "This is a triangle.",
      "Tap each side once."
     ],
     "goal": {
      "sides": 3
     },
     "then": [
      "{sides} straight sides.",
      "This is a triangle because it has 3 straight sides."
     ],
     "hint": [
      "Tap right on the dark lines."
     ]
    },
    {
     "set": {
      "shape": "triangle",
      "rotate": 180,
      "tap": null
     },
     "say": [
      "Now it is upside down.",
      "Is it still a triangle?"
     ],
     "input": "choice",
     "options": [
      {
       "value": "yes",
       "label": "Yes"
      },
      {
       "value": "no",
       "label": "No"
      }
     ],
     "answer": "yes",
     "then": [
      "Yes! Turning a shape does not change its name."
     ]
    },
    {
     "set": {
      "shape": "long-triangle",
      "rotate": 70
     },
     "say": [
      "Long and thin.",
      "Is this a triangle?"
     ],
     "input": "choice",
     "options": [
      {
       "value": "yes",
       "label": "Yes"
      },
      {
       "value": "no",
       "label": "No"
      }
     ],
     "answer": "yes",
     "then": [
      "Yes. It still has 3 straight sides."
     ]
    },
    {
     "set": {
      "shape": "square",
      "rotate": 0,
      "tap": "sides"
     },
     "say": [
      "Tap each side of this shape."
     ],
     "goal": {
      "sides": 4
     },
     "then": [
      "This is not a triangle because it has 4 sides.",
      "It is a square."
     ]
    },
    {
     "set": {
      "shape": "curvy-triangle",
      "tap": null
     },
     "say": [
      "What about this one?",
      "Is it a triangle?"
