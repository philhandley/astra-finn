        {
          "say": [
            "How many minutes in 1 hour?"
          ],
          "input": "numpad",
          "answer": 60,
          "unit": "minutes",
          "then": [
            "60 minutes in 1 hour."
          ]
        },
        {
          "say": [
            "In 1 day, how many times does the short hand go round?"
          ],
          "input": "choice",
          "options": [
            "1",
            "2",
            "24"
          ],
          "answer": "2",
          "then": [
            "Twice! 12 hours, then 12 more."
