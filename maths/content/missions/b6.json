          "then": [
            "9 − 4 = 5.",
            "4 − 9 is not 5."
          ]
        },
        {
          "set": {
            "hold": false
          },
          "say": [
            "The supports are gone. It tips!",
            "Order matters when we subtract."
          ]
        },
        {
          "set": {
            "left": "12 − 5",
