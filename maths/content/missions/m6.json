          "goal": {
            "h": 4,
            "m": 45
          },
          "hint": [
            "The long hand goes on 9.",
            "The short hand is nearly at 5."
          ],
          "then": [
            "Quarter to 5.",
            "The short hand is nearly at 5."
          ]
        }
      ]
    },
