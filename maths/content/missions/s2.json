     ]
    },
    {
     "set": {
      "tap": "edges"
     },
     "say": [
      "Now tap each edge."
     ],
     "goal": {
      "edges": 9
     },
     "then": [
      "{edges} edges: 3 on each triangle and 3 joining them."
