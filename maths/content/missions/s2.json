     "goal": {
      "edges": 12
     },
     "then": [
      "{edges} edges! That is a lot."
     ],
     "hint": [
      "Tap right on the white lines.",
      "Spin it to find the back ones."
     ]
    },
    {
     "set": {
      "tap": "vertices"
     },
     "say": [
      "A vertex is a corner.",
      "Tap each vertex."
     ],
     "goal": {
      "vertices": 8
     },
     "then": [
      "{vertices} vertices: 4 on top, 4 underneath."
     ]
    }
   ]
  },
  {
