    },
    {
     "set": {
      "shape": "cylinder",
      "tap": "faces"
     },
     "say": [
      "A cylinder has flat and curved faces.",
      "Tap them all."
     ],
     "goal": {
      "faces": 3
     },
     "then": [
      "2 flat circles and 1 curved face."
     ]
