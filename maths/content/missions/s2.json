     },
     "say": [
      "Tap each vertex."
     ],
     "goal": {
      "vertices": 5
     },
     "then": [
      "{vertices} vertices. 1 is right at the top."
     ]
    },
    {
     "set": {
      "tap": "edges"
     },
     "say": [
      "How many edges does it have?",
      "Tap to count, then type it."
