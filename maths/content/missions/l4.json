      "props": {
        "colours": [
          7,
          3
        ],
        "frames": 1
      }
    },
    {
      "type": "ask",
      "text": "Have you made number bonds to 10 at school?"
    },
    {
      "type": "guess",
      "prompt": "How many ways can we split 7 into 2 parts?",
      "options": [
        "4 ways",
        "8 ways",
        "12 ways"
      ],
      "answer": 1,
      "reveal": [
        "8 ways!",
        "0 and 7, 1 and 6, all the way to 7 and 0."
      ],
      "widget": "partwhole",
      "props": {
        "whole": 7,
        "parts": [
          3,
          4
        ],
        "hide": 0
      }
    },
    {
      "type": "try",
      "widget": "tensframe",
      "props": {
        "count": 0,
        "frames": 1,
        "twoColour": true
      },
      "script": [
        {
          "say": [
            "Tap the frame to add red counters.",
            "Put in 6."
          ],
          "goal": {
            "a": 6,
            "count": 6
          },
          "hint": [
            "Tap the frame once for each counter.",
            "Tap a counter to take it off."
          ]
        },
        {
          "say": [
            "Now tap the yellow brush.",
            "Fill the rest of the frame."
          ],
          "goal": {
            "count": 10,
            "a": 6
          },
          "hint": [
            "The yellow brush is the yellow circle on the right."
          ],
          "then": [
            "{a} red and {b} yellow make 10.",
            "10 is made of {a} and {b}."
          ]
        },
        {
          "say": [
            "10 is the whole.",
            "{a} is a part. {b} is a part."
          ]
        },
        {
          "set": {
            "colours": [
              3,
              0
            ]
          },
          "say": [
            "3 red counters now.",
            "Fill the frame with yellow."
          ],
          "goal": {
            "count": 10,
            "a": 3
          },
          "hint": [
            "Use the yellow brush.",
            "Tap a counter to take it off."
          ]
        },
        {
          "say": [
            "How many yellow counters did you add?"
          ],
          "input": "numpad",
          "answer": "{b}",
          "then": [
            "3 and {b} make 10."
          ]
        }
      ]
    },
    {
      "type": "try",
      "widget": "partwhole",
      "props": {
        "whole": 7,
        "mode": "split"
      },
      "script": [
        {
          "say": [
            "7 is the whole.",
            "Tap a counter to move it across."
          ],
          "goal": {
            "b": 1
          },
          "hint": [
            "Tap the circle with the red counters."
          ],
          "then": [
            "7 is made of {a} and {b}."
          ]
        },
        {
          "say": [
            "Move one more."
          ],
          "goal": {
            "b": 2
          },
          "then": [
            "Now {a} and {b}.",
            "One part went down by 1. The other went up by 1."
          ]
        },
        {
          "say": [
            "Keep going, one at a time.",
            "Stop when the parts are 3 and 4."
          ],
          "goal": {
            "a": 3,
            "b": 4
          },
          "hint": [
            "Tap the part with more counters."
          ],
          "then": [
            "7 is made of 3 and 4."
          ]
        },
        {
          "say": [
            "Find every way to split 7.",
            "Move the counters back and forth."
          ],
          "goal": {
            "ways": {
              "gte": 8
            }
          },
          "hint": [
            "Move them all to one side.",
            "Then move them back one at a time."
          ],
          "then": [
            "You found all 8 ways!",
            "7 and 0 counts too."
          ]
        }
      ]
    },
    {
      "type": "try",
      "widget": "objects",
      "props": {
        "n": 6,
        "arrange": "groups",
        "groups": [
