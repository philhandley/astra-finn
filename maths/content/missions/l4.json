          ],
          "input": "choice",
          "options": [
            "Odd",
            "Even"
          ],
          "answer": "Odd",
          "then": [
            "1 boot is left over.",
            "7 is odd."
          ]
        },
        {
          "set": {
            "n": 10,
            "groups": [
              2,
              2,
              2,
              2,
              2
            ]
          },
          "say": [
            "What about 10 boots?"
          ],
          "input": "choice",
          "options": [
            "Odd",
            "Even"
          ],
          "answer": "Even",
          "then": [
            "10 is even.",
            "5 pairs, none left over."
          ]
        }
      ]
    },
    {
      "type": "practise",
      "gen": "addsub.bondsTo",
