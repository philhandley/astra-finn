  "patch": {
    "name": "Across the Ten",
    "icon": "tensframe"
  },
  "dadNotes": [
    "Make 10 first: 8 + 5 = 8 + 2 + 3. Ask 'how many fill the frame?'",
    "Two ways to subtract across 10: through 10 (15 − 5 − 4) or from 10 (10 − 9, then add 5).",
    "Doubles of 6 to 9 should become instant: 6 + 6, 7 + 7, 8 + 8, 9 + 9."
  ],
  "steps": [
    {
      "type": "look",
      "lines": [
        "8 gold and 5 blue.",
        "2 blue counters filled the first frame."
      ],
      "question": "How many altogether?",
