  "dadNotes": [
    "Use the pairs of words: longer and shorter, taller and shorter, heavier and lighter, more and less.",
    "Line things up at one end before comparing lengths. That is what makes it fair.",
    "In Year 1, mass and weight mean the same thing, and so do capacity and volume."
  ],
  "steps": [
    {
      "type": "look",
      "lines": [
        "A rocket and an astronaut.",
        "Both stand on the same line."
      ],
      "question": "Which is taller?",
      "widget": "measure",
      "props": {
        "tool": "compare",
        "kind": "height",
        "a": 6,
        "b": 3,
        "icons": [
          "rocket",
          "astronaut"
        ]
      },
      "options": [
        "Rocket",
        "Astronaut",
        "Same"
      ],
      "answer": 0,
      "reveal": [
        "The rocket's top is higher up.",
        "Count the cubes: rocket 6, astronaut 3."
      ],
      "revealProps": {
        "cubes": true
      }
    },
    {
      "type": "ask",
      "text": "Have you compared longer and shorter at school?"
    },
    {
      "type": "guess",
      "prompt": "How many cubes long is the worm?",
      "widget": "measure",
      "props": {
        "tool": "compare",
        "kind": "length",
        "a": 7,
        "icons": [
          "worm"
        ]
      },
      "options": [
        "About 3",
        "About 7",
        "About 15"
      ],
      "answer": 1,
      "revealProps": {
        "cubes": true
      },
      "reveal": [
        "7 cubes long.",
        "We measured it with cubes."
      ]
    },
    {
      "type": "try",
      "widget": "measure",
      "props": {
        "tool": "compare",
        "kind": "length",
        "a": 7,
        "b": 4,
        "icons": [
          "worm",
          "pencil"
        ],
        "cubes": true,
        "interactive": false
      },
      "script": [
        {
          "say": [
            "The worm and the pencil start at the same line."
          ]
        },
        {
          "say": [
            "Which is longer?"
          ],
          "input": "choice",
          "options": [
            "worm",
            "pencil"
          ],
          "answer": "worm",
          "then": [
            "The worm is longer.",
            "The pencil is shorter."
          ],
          "hint": [
            "Both start at the dashed line.",
            "Which one reaches further along?"
          ]
        },
        {
          "say": [
            "How many cubes long is the pencil?"
          ],
          "input": "numpad",
          "answer": 4,
          "unit": "cubes",
          "then": [
            "4 cubes. The worm is 7 cubes."
          ],
          "hint": [
            "Count the yellow cubes under the pencil.",
            "Touch each one as you count."
          ]
        },
        {
          "say": [
            "How many cubes longer is the worm?"
          ],
          "input": "numpad",
          "answer": 3,
          "unit": "cubes",
          "hint": [
            "The pencil has 4 cubes. The worm has 7.",
            "Count on from 4 to 7."
          ],
          "then": [
            "7 is 3 more than 4.",
            "The worm is 3 cubes longer."
          ]
        }
      ]
    },
    {
      "type": "try",
      "widget": "measure",
      "props": {
        "tool": "compare",
        "kind": "mass",
        "a": 5,
        "b": 1,
        "icons": [
          "asteroid"
        ],
        "cubes": true
      },
      "script": [
        {
          "say": [
            "This is a balance.",
            "The heavier side goes down."
          ]
        },
        {
          "say": [
            "Which side is heavier now?"
          ],
          "input": "choice",
          "options": [
            "the rock",
            "the cubes"
          ],
          "answer": "the rock",
          "then": [
            "The rock side is down.",
            "The rock is heavier than 1 cube."
          ],
          "hint": [
            "The heavier side goes down.",
            "Which pan is lower?"
          ]
        },
        {
          "say": [
            "Tap + to add cubes.",
            "Make the balance level."
          ],
          "goal": {
            "b": 5
          },
          "hint": [
            "Add 1 cube at a time.",
            "Stop when both sides are level."
          ],
          "then": [
            "Level! The rock weighs the same as {b} cubes."
          ],
          "explain": [
            "The rock weighs the same as 5 cubes.",
            "Now the balance is level."
          ]
        },
        {
          "say": [
            "Add 1 more cube."
          ],
          "goal": {
            "b": 6
          },
          "then": [
            "Now the cubes are heavier.",
            "The rock is lighter."
          ],
          "hint": [
            "Tap the + button 1 more time.",
            "Watch which side goes down."
          ],
          "explain": [
            "6 cubes are heavier than the rock.",
            "So the cubes side goes down."
          ]
        }
      ]
    },
    {
