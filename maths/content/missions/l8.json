     ]
    },
    {
     "say": [
      "Tap Glue.",
      "Stick the quarters back into halves."
     ],
     "goal": {
      "parts": 2
     },
     "then": [
      "2 quarters make 1 half."
     ],
     "hint": [
      "Tap the Glue button under the hammer."
     ],
     "explain": [
      "Glue sticks 2 quarters together.",
      "2 quarters make 1 half."
     ]
    }
