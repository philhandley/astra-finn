      "lines": ["Sixty-four is 64.", "It is made of sixty and four.", "The little line is a hyphen."],
      "caption": "64",
      "big": "sixty-four"
    },
    { "type": "ask", "text": "Have you written numbers in words at school?" },
    {
      "type": "guess",
      "prompt": "Which word has more letters: sixty or sixteen?",
