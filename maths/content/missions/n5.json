      "answer": 1,
      "reveal": ["Sixteen has 7 letters. Sixty has 5.", "But sixty is the bigger number!"],
      "art": "rocket"
    },
    {
      "type": "try",
      "widget": "placevalue",
      "props": { "tens": 0, "ones": 0, "showDigits": true },
      "script": [
        { "caption": "sixty-four", "say": ["Build sixty-four.", "Sixty is how many tens?"], "goal": { "tens": 6 }, "then": ["Sixty is 6 tens."], "hint": ["Count in tens: ten, twenty, thirty..."] },
        { "say": ["Now add four."], "goal": { "tens": 6, "ones": 4 }, "then": ["Sixty and four make sixty-four.", "We write {value}."] },
        { "set": { "tens": 0, "ones": 0 }, "caption": "forty", "say": ["Build forty."], "goal": { "value": 40, "tens": 4, "ones": 0 }, "then": ["Forty is 4 tens.", "No extra ones."] },
        { "set": { "tens": 0, "ones": 0 }, "caption": "fourteen", "say": ["Now build fourteen."], "goal": { "value": 14, "tens": 1, "ones": 4 }, "then": ["Fourteen is 1 ten and 4 ones.", "Forty and fourteen sound alike!"], "hint": ["Teen means 1 ten and some more."] },
        { "set": { "tens": 0, "ones": 0 }, "caption": "seventy-three", "say": ["Build seventy-three."], "goal": { "value": 73, "tens": 7, "ones": 3 }, "then": ["Seventy-three is {value}."] },
        { "caption": "", "say": ["Which words say 37?"], "input": "choice", "options": ["seventy-three", "thirty-seven", "seventeen"], "answer": "thirty-seven", "then": ["Thirty-seven: 3 tens and 7 ones."] }
      ]
    },
    {
