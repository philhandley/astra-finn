{
  "id": "n5",
  "sector": "number",
  "title": "Numbers in Words to 100",
  "tagline": "Read and write numbers to 100",
  "covers": ["Y2-NPV-5"],
  "patch": {"name": "Number Words", "icon": "words"},
  "dadNotes": [
    "Teen means 1 ten and some ones (fourteen is 14). 'Ty' means tens (forty is 40).",
    "A hyphen joins the tens and the ones: sixty-four is sixty and four.",
    "Spelling to watch: forty (no u), eight, eighteen, eighty."
  ],
  "warmup": {
    "gen": "number.numberWords",
    "level": 1,
    "items": 3,
    "params": {"min": 11},
    "mission": "l2",
    "say": "First, a quick warm-up: number words to 20."
  },
  "steps": [
    {
      "type": "look",
      "lines": ["This number is in words.", "The little line is a hyphen."],
      "question": "Which number is sixty-four?",
      "options": ["46", "64", "604"],
      "answer": 1,
      "reveal": ["Sixty is 6 tens. Four is 4 ones.", "Sixty and four make 64."],
      "caption": "sixty-four",
      "widget": "placevalue",
      "props": {"tens": 6, "ones": 4, "interactive": false},
      "revealProps": {"showDigits": true, "showExpanded": true, "showValue": true}
    },
    {"type": "ask", "text": "Have you written numbers in words at school?"},
    {
      "type": "guess",
      "prompt": "Which word has more letters: sixty or sixteen?",
      "options": ["sixty", "sixteen", "The same"],
      "answer": 1,
      "reveal": [
        "Sixteen has 7 letters. Sixty has 5.",
        "But sixty is much further along the line.",
        "Sixty is the bigger number!"
      ],
      "widget": "numberline",
      "props": {
        "min": 0,
        "max": 70,
        "step": 10,
        "minor": 0,
        "labels": "tens",
        "marks": [{"at": 16, "label": "sixteen", "colour": "purple"}, {"at": 60, "label": "sixty", "colour": "orange"}]
      }
    },
    {
      "type": "try",
      "widget": "placevalue",
      "props": {"tens": 0, "ones": 0, "showDigits": true},
      "script": [
        {
          "caption": "sixty-four",
          "say": ["Build sixty-four.", "First make sixty with the tens."],
          "goal": {"tens": 6},
          "then": ["Sixty is 6 tens."],
          "hint": ["Tap + under Tens and count:", "ten, twenty, thirty... sixty."]
        },
        {
          "say": ["Now add four."],
          "goal": {"tens": 6, "ones": 4},
          "then": ["Sixty and four make sixty-four.", "We write {value}."],
          "hint": ["Four is 4 ones.", "Tap + under Ones 4 times."]
        },
        {
          "set": {"tens": 0, "ones": 0},
          "caption": "forty",
          "say": ["Build forty."],
          "goal": {"value": 40, "tens": 4, "ones": 0},
          "then": ["Forty is 4 tens.", "No extra ones."],
          "hint": ["Forty sounds like four: 4 tens.", "Count: ten, twenty, thirty, forty."]
        },
        {
          "set": {"tens": 0, "ones": 0},
          "caption": "fourteen",
          "say": ["Now build fourteen."],
          "goal": {"value": 14, "tens": 1, "ones": 4},
          "then": ["Fourteen is 1 ten and 4 ones.", "Forty and fourteen sound alike!"],
          "hint": ["Teen means 1 ten and some more.", "1 ten, then 4 ones."]
        },
        {
          "set": {"tens": 0, "ones": 0},
          "caption": "seventy-three",
          "say": ["Build seventy-three."],
          "goal": {"value": 73, "tens": 7, "ones": 3},
          "then": ["Seventy-three is {value}."],
          "hint": ["Seventy is 7 tens.", "Three is 3 ones."]
        },
        {
          "caption": "37",
          "say": ["Which words say 37?"],
          "input": "choice",
          "options": ["seventy-three", "thirty-seven", "seventeen"],
          "answer": "thirty-seven",
          "then": ["Thirty-seven: 3 tens and 7 ones."],
          "set": {"tens": 3, "ones": 7},
          "hint": ["The blocks show 3 tens and 7 ones.", "3 tens is thirty."]
        }
      ]
    },
    {
      "type": "practise",
      "gen": "number.numberWords",
      "levels": [2, 3, 3],
      "items": [6, 7, 8],
      "intro": ["Your turn, {commander}.", "Words and digits."]
    },
    {
      "type": "practise",
      "tiers": [2, 3],
      "gen": "number.numberWords",
      "params": {"dir": "toDigits"},
      "levels": [3, 3, 3],
      "items": [3, 3, 4],
      "intro": ["Type the words in digits."]
    },
    {
      "type": "error",
      "intro": ["{engineer} wrote these numbers in digits.", "Can you spot the slip?"],
      "lines": ["Words into digits:", "sixty-two = 62", "fourteen = 40", "ninety = 90"],
      "wrong": 2,
      "fix": ["Fourteen is 14. Forty is 40.", "What would you tell {engineer}?"]
    },
    {
      "type": "athome",
      "title": "Number word hunt",
      "need": ["A book, a comic or some food packets"],
      "steps": ["Find a number written as a word.", "Write it in digits.", "Find the biggest one."],
      "why": "Reading number words in real life makes them stick."
    },
    {"type": "finish", "debrief": ["What was your favourite part?", "How are fourteen and forty different?"]}
  ]
}
